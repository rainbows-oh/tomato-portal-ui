<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-d28dceaf" version="1.0.6190">
  <head std:sid="head-cf1cd2af">
    <screen std:sid="screen-8481c550" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-7ab45046" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-a54fb6c3" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-9f428c95"/>
    <cl:appspec title="조회영역 우측 툴바">
      <cl:property name="value" type="enumeration" default="grid" bindable="true" translatable="false" std:desc="Change view (Grid or card)">
        <cl:available-value>grid</cl:available-value>
        <cl:available-value>card</cl:available-value>
      </cl:property>
      <cl:property name="dateVisible" type="boolean" default="true" bindable="true" translatable="false" std:desc="Show the Date sort checkbox"/>
      <cl:property name="companyNameVisible" type="boolean" default="true" bindable="true" translatable="false" std:desc="Show the Company Name sort checkbox"/>
      <cl:property name="targetCard" type="control" std:desc="group of card control"/>
      <cl:property name="targetGrid" type="control" std:desc="Grid control"/>
      <cl:event name="selection-change" type="cpr.events.CAppEvent"/>
    </cl:appspec>
  </head>
  <body std:sid="body-b9e20b4b" style="top:0px; left:0px; width:300px; height:32px;" class="result-toolbar" fieldLabel="Results view">
    <cl:listener std:sid="listener-c6850c21" name="property-change" handler="onBodyPropertyChange"/>
    <cl:listener std:sid="listener-41a4f119" name="init" handler="onBodyInit"/>
    <cl:checkbox std:sid="c-box-6744ae62" id="chkDate" text="Date" iconalign="right">
      <cl:flowlayoutdata std:sid="f-data-3dc7cb18" width="82px" height="32px" autosize="width"/>
    </cl:checkbox>
    <cl:checkbox std:sid="c-box-35f2c221" id="chkCompanyName" text="Company Name" iconalign="right">
      <cl:flowlayoutdata std:sid="f-data-23201edd" width="129px" height="32px" autosize="width"/>
    </cl:checkbox>
    <cl:button std:sid="button-188529e6" id="btnShowGrid" class="btn-grid active" value="Grid view" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
      <cl:listener std:sid="listener-bd306c80" name="click" handler="onBtnShowGridClick"/>
      <cl:expbind property="fieldLabel" category="PROPERTY" expression="this.style.hasClass(&quot;active&quot;) ? text + &quot; selected&quot; : text"/>
      <cl:flowlayoutdata std:sid="f-data-11b08e23" width="32px" height="32px"/>
    </cl:button>
    <cl:button std:sid="button-24b4f02d" id="btnShowCard" class="btn-card" value="Card view" displayexp="sstr(text, [&quot;cl-sound-only&quot;])" icon="0">
      <cl:listener std:sid="listener-4e32536c" name="click" handler="onBtnShowCardClick"/>
      <cl:expbind property="fieldLabel" category="PROPERTY" expression="this.style.hasClass(&quot;active&quot;) ? text + &quot; selected&quot; : text"/>
      <cl:flowlayoutdata std:sid="f-data-947e8700" width="32px" height="32px"/>
    </cl:button>
    <cl:flowlayout std:sid="f-layout-ba69191e" scrollable="false" hspacing="8" vspacing="0" linewrap="false"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>